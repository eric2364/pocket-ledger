{
  "expo": {
    "name": "Pocket Ledger",
    "slug": "pocket-ledger-personal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F4EF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.eric2364.pocketledger",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.eric2364.pocketledger",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F4EF"
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-document-picker",
      "expo-sharing"
    ]
  }
}
